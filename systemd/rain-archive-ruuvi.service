[Unit]
Description=RuuviTag check: broadcast sample + history download over Bluetooth
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -m rainarchive.ruuvi -c __DIR__/config.toml sync
Nice=10
TimeoutStartSec=30min
